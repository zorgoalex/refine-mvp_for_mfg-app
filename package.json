{
  "name": "front_refine_v1",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "dev": "node --max-old-space-size=4096 node_modules/vite/bin/vite.js",
    "dev:api": "vercel dev --listen 3001",
    "dev:full": "concurrently \"npm run dev\" \"npm run dev:api\" --names \"vite,api\" --prefix-colors \"cyan,magenta\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:backend": "vitest run backend",
    "test:backend:deadline-integration": "vitest run --config vitest.deadline-integration.config.ts",
    "test:backend:notification-integration": "vitest run --config vitest.notification-engine-integration.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:frontend-pages": "playwright test tests/frontend-pages-smoke.spec.ts",
    "test:e2e:frontend-pages-stage-canary": "FRONTEND_PAGES_STAGE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/frontend-pages-stage-canary.spec.ts --project=chromium",
    "test:e2e:calendar": "playwright test tests/calendar-frontend.spec.ts",
    "test:e2e:calendar-stage-canary": "CALENDAR_STAGE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/calendar-frontend.spec.ts --project=chromium",
    "test:e2e:users-cutover": "VITE_USE_BACKEND_AUTH=true VITE_USE_BACKEND_PERMISSIONS=true VITE_USE_BACKEND_USERS=true playwright test tests/users-backend-cutover.spec.ts",
    "test:e2e:order-export-cutover": "VITE_USE_BACKEND_ORDER_EXPORT=true playwright test tests/order-export-backend-cutover.spec.ts",
    "test:e2e:payments-cutover": "VITE_USE_BACKEND_PAYMENTS=true playwright test tests/payments-backend-cutover.spec.ts",
    "test:e2e:production-actions-cutover": "VITE_USE_BACKEND_PRODUCTION_ACTIONS=true playwright test tests/production-actions-backend-cutover.spec.ts",
    "test:e2e:client-phones-cutover": "VITE_USE_BACKEND_PRODUCTION_ACTIONS=true VITE_USE_BACKEND_CLIENT_PHONES=true playwright test tests/client-phones-backend-cutover.spec.ts",
    "test:e2e:production-actions-stage-canary": "PRODUCTION_ACTIONS_STAGE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/production-actions-stage-canary.spec.ts --project=chromium",
    "test:e2e:production-actions-mode-stage-canary": "PRODUCTION_ACTIONS_MODE_STAGE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/production-actions-mode-stage-canary.spec.ts --project=chromium",
    "test:e2e:deadline-engine-stage-canary": "DEADLINE_ENGINE_STAGE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/deadline-engine-stage-canary.spec.ts --project=chromium",
    "test:e2e:deadline-create-override-stage-canary": "DEADLINE_CREATE_OVERRIDE_RESTORE=true DEADLINE_CREATE_OVERRIDE_STAGE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/deadline-engine-create-override-stage-canary.spec.ts --project=chromium",
    "test:e2e:deadline-policy-settings-stage-canary": "DEADLINE_POLICY_SETTINGS_STAGE_CANARY=true DEADLINE_POLICY_SETTINGS_RESTORE=true DEADLINE_POLICY_SETTINGS_TARGET_ENV=backend-test PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/deadline-policy-settings-stage-canary.spec.ts --project=chromium",
    "test:e2e:deadline-worker-stage-canary": "DEADLINE_ENGINE_STAGE_WORKER_WRITE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/deadline-engine-worker-stage-canary.spec.ts --project=chromium",
    "test:e2e:deadline-scheduler-external-canary": "DEADLINE_SCHEDULER_EXTERNAL_OWNER_STAGE_CANARY=true BACKEND_DEADLINE_WORKER_SCHEDULER_OWNER=external PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/deadline-scheduler-external-owner-stage-canary.spec.ts --project=chromium",
    "test:e2e:deadline-notification-action-stage-canary": "DEADLINE_NOTIFICATION_ACTION_STAGE_CANARY=true DEADLINE_NOTIFICATION_ACTION_RESTORE=true DEADLINE_NOTIFICATION_ACTION_TARGET_ENV=backend-test PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/deadline-engine-notification-action-stage-canary.spec.ts --project=chromium",
    "test:e2e:notification-engine-stage-canary": "NOTIFICATION_ENGINE_STAGE_CANARY=true NOTIFICATION_ENGINE_TARGET_ENV=backend-test NOTIFICATION_ENGINE_FIXTURE_RESTORE=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/notification-engine-stage-canary.spec.ts --project=chromium",
    "test:e2e:deadline-status-transition-stage-canary": "DEADLINE_STATUS_TRANSITION_STAGE_CANARY=true DEADLINE_STATUS_TRANSITION_RESTORE=true DEADLINE_STATUS_TRANSITION_TARGET_ENV=backend-test PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/deadline-status-transition-stage-canary.spec.ts --project=chromium",
    "test:e2e:deadline-order-save-sync-stage-canary": "DEADLINE_ORDER_SAVE_SYNC_STAGE_CANARY=true DEADLINE_ORDER_SAVE_SYNC_RESTORE=true DEADLINE_ORDER_SAVE_SYNC_TARGET_ENV=backend-test PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/deadline-order-save-sync-stage-canary.spec.ts --project=chromium",
    "test:e2e:deadline-escalate-stage-canary": "DEADLINE_ESCALATE_STAGE_CANARY=true DEADLINE_ESCALATE_RESTORE=true DEADLINE_ESCALATE_TARGET_ENV=backend-test PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/deadline-escalate-stage-canary.spec.ts --project=chromium",
    "test:e2e:payments-stage-canary": "PAYMENTS_STAGE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/payments-stage-canary.spec.ts --project=chromium",
    "test:e2e:client-phones-stage-canary": "CLIENT_PHONES_STAGE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/client-phones-stage-canary.spec.ts --project=chromium",
    "test:e2e:order-ui-full-coverage": "ORDER_UI_FULL_COVERAGE=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/order-ui-full-form-coverage.spec.ts --project=chromium",
    "test:e2e:order-created-by-stage-canary": "ORDER_CREATED_BY_STAGE_CANARY=true PLAYWRIGHT_SKIP_WEB_SERVER=true playwright test tests/order-created-by-stage-canary.spec.ts --project=chromium",
    "test:e2e:vlm-cutover": "VITE_USE_BACKEND_VLM=true playwright test tests/vlm-backend-cutover.spec.ts",
    "deadline-worker:fixture": "node scripts/deadline-worker-fixture.js",
    "deadline-notification-action:fixture": "node scripts/deadline-notification-action-fixture.js",
    "deadline-status-transition:fixture": "node scripts/deadline-status-transition-fixture.js",
    "deadline-escalate:fixture": "node scripts/deadline-escalate-fixture.js",
    "test:deadline-notification-action-fixture": "vitest run scripts/deadline-notification-action-fixture-lib.test.js",
    "test:deadline-status-transition-fixture": "vitest run scripts/deadline-status-transition-fixture-lib.test.js",
    "test:deadline-escalate-fixture": "vitest run scripts/deadline-escalate-fixture-lib.test.js",
    "test:e2e:runtime-config": "playwright test tests/frontend-runtime-config.spec.ts",
    "test:runtime-config-canary": "node scripts/check-runtime-config-canary.js",
    "smoke:runtime-config": "node scripts/smoke-runtime-config.js",
    "smoke:staging-gates": "node scripts/smoke-staging-gates.js",
    "smoke:stage-cutover": "node scripts/stage-cutover-smoke.js",
    "test:e2e:regression": "playwright test tests/regression tests/frontend-pages-smoke.spec.ts tests/frontend-runtime-config.spec.ts tests/order-workflows.spec.ts tests/reference-workflows.spec.ts --project=chromium"
  },

{
  "parse": [
    { "template": "Заявка {номер}", "scope": "body", "ok": true },
    { "template": "{{номер}} и {номер}", "scope": "body", "ok": true },
    { "template": "Скобка {номер", "scope": "body", "ok": false, "code": "UNCLOSED_BRACE" },
    { "template": "Скобка } одна", "scope": "body", "ok": false, "code": "STRAY_BRACE" },
    { "template": "{неизвестное}", "scope": "body", "ok": false, "code": "UNKNOWN_FIELD" },
    { "template": "{материал}", "scope": "body", "ok": false, "code": "UNKNOWN_FIELD" },
    { "template": "{позиции}", "scope": "line", "ok": false, "code": "UNKNOWN_FIELD" },
    { "template": "{№}. {материал} — {количество} {единица}", "scope": "line", "ok": true },
    { "template": "{ }", "scope": "body", "ok": false, "code": "BAD_FIELD" }
  ],
  "render": [
    {
      "name": "standard",
      "body": "Заявка {номер} · {поставщик}\n{позиции}\nОжидаем к: {ожидаем_к}\n{комментарий}",
      "line": "{материал} — {количество_с_единицей}",
      "values": { "номер": "26-0001", "поставщик": "Мебель-Трейд", "дата": "02.10.2026", "ожидаем_к": "", "комментарий": "", "позиций_всего": "2" },
      "lines": [
        { "№": "1", "материал": "МДФ 16мм", "количество": "2", "единица": "лист", "количество_с_единицей": "2 лист" },
        { "№": "2", "материал": "Плёнка {белая}", "количество": "12,5", "единица": "пог. м", "количество_с_единицей": "12,5 пог. м" }
      ],
      "expected": "Заявка 26-0001 · Мебель-Трейд\nМДФ 16мм — 2 лист\nПлёнка {белая} — 12,5 пог. м"
    },
    {
      "name": "literal values, multiline comment, escapes",
      "body": "{{номер}} = {номер}\nКомментарий:\n{комментарий}\nСрок: {ожидаем_к}",
      "line": "{№}) {материал}",
      "values": { "номер": "{поставщик}", "поставщик": "X", "дата": "", "ожидаем_к": "", "комментарий": "строка 1\nстрока 2", "позиций_всего": "0" },
      "lines": [],
      "expected": "{номер} = {поставщик}\nКомментарий:\nстрока 1\nстрока 2"
    },
    {
      "name": "unclosed brace renders as literal",
      "body": "Итого {позиций_всего} шт. {номер",
      "line": "{материал}",
      "values": { "номер": "1", "поставщик": "", "дата": "", "ожидаем_к": "", "комментарий": "", "позиций_всего": "3" },
      "lines": [],
      "expected": "Итого 3 шт. {номер"
    }
  ]
}

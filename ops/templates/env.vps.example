# Copy to .env on the VPS and replace every REPLACE_ME / example domain.
# Keep this file shell-compatible: no spaces around "=" and quote values with
# spaces or special shell characters.

## Explicit stack target. Test stacks may read Telegram but must not write replies.
## Existing prod stacks may keep their current COMPOSE_PROJECT_NAME to avoid
## named-volume migration, but must set ERP_STACK_ENV=prod.
ERP_STACK_ENV=test
COMPOSE_PROJECT_NAME=erp_test
EDGE_NETWORK_NAME=erp_test_edge
## Empty by default. Set to cnc-telegram only on the stack that should run
## the internal Telethon worker.
# COMPOSE_PROFILES=cnc-telegram
COMPOSE_PROFILES=

## Public domains
## FQDN values are hostnames only, without https:// and without path.
HASURA_FQDN=hasura-test.example.com
BACKEND_FQDN=backend-test.example.com
CAD_FQDN=cad-test.example.com

## Browser origin of the frontend that will call backend/Hasura.
## Origin includes scheme and host, no trailing slash.
FRONTEND_ORIGIN=https://app-test.example.com

## Traefik / Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com

## Main application database
PG_DB=erpdb
PG_USER=erp_user
PG_PASSWORD=REPLACE_ME_MAIN_DB_PASSWORD

## Published Postgres bind.
## Use 127.0.0.1 for no external DB access.
## Use the VPS Tailscale IP when backup/restore/admin access over tailnet is needed.
PG_BIND_IP=127.0.0.1

## Hasura connects to the business DB.
## If the DB is local in this compose stack, use postgresdb as host.
## URL-encode PG_USER/PG_PASSWORD if they contain @ : / ? # or spaces.
HASURA_GRAPHQL_DATABASE_URL=postgres://erp_user:REPLACE_ME_MAIN_DB_PASSWORD@postgresdb:5432/erpdb

## Hasura metadata DB, always local to this stack
HASURA_MD_DB=hasura_md
HASURA_MD_USER=hasura_user
HASURA_MD_PASSWORD=REPLACE_ME_HASURA_METADATA_DB_PASSWORD

## Hasura security/runtime
HASURA_ENABLE_CONSOLE=false
HASURA_ADMIN_SECRET=REPLACE_ME_HASURA_ADMIN_SECRET
HASURA_JWT_SECRET=REPLACE_ME_SHARED_JWT_SECRET_AT_LEAST_32_CHARS
HASURA_LOG_LEVEL=info
HASURA_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,query-log

## Hasura CORS: comma-separated browser origins.
HASURA_GRAPHQL_CORS_DOMAIN=https://app-test.example.com

## Backend security/runtime
## Default VPS layout is ~/projects/erp_dev/repo_erp with .env/data/restore
## in ~/projects/erp_dev, so the backend build context is nested under repo_erp.
## For a one-repo checkout, override this to ./backend.
BACKEND_BUILD_CONTEXT=./repo_erp/backend
BACKEND_NODE_ENV=production
BACKEND_APP_NAME=erp-backend
BACKEND_REFRESH_TOKEN_PEPPER=REPLACE_ME_REFRESH_TOKEN_PEPPER_AT_LEAST_32_CHARS
ACCESS_TOKEN_TTL_SECONDS=900
AUTH_SESSION_TTL_SECONDS=36000
BACKEND_CORS_ALLOWED_ORIGINS=https://app-test.example.com
BACKEND_SWAGGER_ENABLED=false

## Backend feature gates
BACKEND_ENABLE_AUTH=true
BACKEND_ENABLE_ORDERS=true
BACKEND_ENABLE_PAYMENTS=true
BACKEND_ENABLE_PRODUCTION_ACTIONS=false
BACKEND_ENABLE_CLIENT_PHONES=false
BACKEND_ENABLE_DOWELING_COMMANDS=false
BACKEND_ENABLE_LABELS=false
BACKEND_ENABLE_BAZIS=false
BACKEND_ENABLE_BAZIS_CUT=false
BACKEND_ENABLE_CNC_TELEGRAM=false
# событийные автостатусы, движок off by default
BACKEND_STATUS_AUTOMATION=false
# Hybrid SSO login via WorkOS AuthKit (requires BACKEND_ENABLE_AUTH=true and
# migration 052 applied in the same window). Secrets live only in the real .env.
BACKEND_ENABLE_WORKOS_AUTH=false
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=
BACKEND_ORDERS_READ_ONLY=false
BACKEND_ENABLE_USERS=true
BACKEND_ENABLE_ORDER_EXPORT=true
BACKEND_EXPORT_DISABLED=true
BACKEND_ENABLE_VLM=true
BACKEND_VLM_DISABLED=true
BACKEND_ENABLE_GROUPS=false
BACKEND_GROUPS_READ_ONLY=true
BACKEND_ENABLE_GROUPS_BATCH_LINK_WRITE=false
BACKEND_ENABLE_GROUP_P8_NOTIFICATIONS=false
BACKEND_ENABLE_DEADLINES=false
BACKEND_ENABLE_DEADLINE_ORDER_SYNC=false
BACKEND_DEADLINES_READ_ONLY=true
BACKEND_ENABLE_DEADLINE_WORKER=false
BACKEND_DEADLINE_ACTIONS_ENABLED=false
BACKEND_DEADLINE_NOTIFICATIONS_ENABLED=false
BACKEND_ENABLE_NOTIFICATION_ENGINE=false
BACKEND_NOTIFICATION_RULES_READ_ONLY=true
BACKEND_OUTBOX_RELAY_OWNER=none
BACKEND_OUTBOX_RELAY_POLL_INTERVAL_MS=60000
BACKEND_OUTBOX_RELAY_BATCH_SIZE=100
BACKEND_OUTBOX_RELAY_WORKER_ID=backend-local
BACKEND_OUTBOX_RELAY_MAX_ATTEMPTS=10
BACKEND_ENABLE_TELEGRAM_NOTIFICATIONS=false
TELEGRAM_NOTIFICATION_BOT_TOKEN=
TELEGRAM_NOTIFICATION_BOT_USERNAME=
TELEGRAM_NOTIFICATION_WEBHOOK_SECRET=
# Public HTTPS endpoint used by the webhook setup script; not sent to Telegram messages.
TELEGRAM_NOTIFICATION_WEBHOOK_PUBLIC_URL=https://backend.example.com/api/v1/notification-channels/telegram/webhook
TELEGRAM_NOTIFICATION_API_BASE=https://api.telegram.org
TELEGRAM_NOTIFICATION_REQUEST_TIMEOUT_MS=10000
TELEGRAM_NOTIFICATION_LINK_TTL_SECONDS=600
BACKEND_TELEGRAM_NOTIFICATION_RELAY_OWNER=none
BACKEND_TELEGRAM_NOTIFICATION_RELAY_POLL_INTERVAL_MS=10000
BACKEND_TELEGRAM_NOTIFICATION_RELAY_BATCH_SIZE=50
BACKEND_TELEGRAM_NOTIFICATION_RELAY_WORKER_ID=telegram-notifications-local
BACKEND_TELEGRAM_NOTIFICATION_RELAY_MAX_ATTEMPTS=10
BACKEND_TELEGRAM_NOTIFICATION_RELAY_STALE_LOCK_MS=600000

## =====================================================================
## PROD-FULL profile (go-live override)
## ---------------------------------------------------------------------
## The BACKEND_ENABLE_* defaults above are CUTOVER-SAFE, not a prod config:
## the template was built for migrating the old Hasura-only system to the
## backend one feature at a time, so most modules default OFF (= frontend
## serves that feature from the legacy Hasura path). For a NEW prod where
## everything runs through the backend, DO NOT rely on these defaults —
## uncomment the block below (override the values above) so the frontend's
## backend calls don't hit "<feature> is disabled" -> 503.
##
## Two-level gate: BACKEND_ENABLE_* (module exists) + *_DISABLED (external
## provider; *_DISABLED=false needs creds — GAS_* for export, VLM_API_URL +
## AUTH0_M2M_* for VLM; no creds -> keep *_DISABLED=true).
## Mirror the matching RUNTIME_CONFIG_BACKEND_* on the Vercel frontend.
## NOTE: there is intentionally NO BACKEND_ENABLE_REFERENCES — references
## stay on Hasura (do not set RUNTIME_CONFIG_BACKEND_REFERENCES=true).
##
# BACKEND_ENABLE_PRODUCTION_ACTIONS=true
# BACKEND_ENABLE_CLIENT_PHONES=true          # requires production_actions=true
# BACKEND_ENABLE_GROUPS=true
# BACKEND_GROUPS_READ_ONLY=false
# BACKEND_ENABLE_SHEET_MATERIALS=true
# BACKEND_SHEET_ORDERS_READS=true
# BACKEND_ENABLE_CUT_JOBS=true
# BACKEND_CUT_JOBS_READ_ONLY=false
# FREECUT_BASE_URL=http://freecut:8088
# CAD_SERVICE_BASE_URL=http://cad-service:8000
# BACKEND_ENABLE_DEADLINES=true
# BACKEND_DEADLINES_READ_ONLY=false
# BACKEND_ENABLE_DOWELING_COMMANDS=true
# BACKEND_ENABLE_LABELS=true
# BACKEND_ENABLE_BAZIS=true
# BACKEND_ENABLE_BAZIS_CUT=true             # requires migration 068
# BACKEND_STATUS_AUTOMATION=true
# # external providers — module ON, but only work WITH creds:
# BACKEND_EXPORT_DISABLED=false              # needs GAS_WEBAPP_URL/GAS_API_KEY
# BACKEND_VLM_DISABLED=false                 # needs VLM_API_URL/AUTH0_M2M_*
# # background/owner flags stay OFF unless deliberately needed:
# #   BACKEND_ENABLE_NOTIFICATION_ENGINE / BACKEND_OUTBOX_RELAY_OWNER /
# #   BACKEND_ENABLE_DEADLINE_WORKER / BACKEND_ENABLE_BITRIX24_SYNC /
# #   BACKEND_ENABLE_DEADLINE_ORDER_SYNC / BACKEND_ENABLE_ORG_MANAGEMENT
## =====================================================================

## Google Drive export. Required only when BACKEND_EXPORT_DISABLED=false.
GAS_WEBAPP_URL=
GAS_API_KEY=
GAS_EXPORT_TIMEOUT_MS=55000

## VLM. Required only when BACKEND_VLM_DISABLED=false.
VLM_API_URL=
VLM_HEALTH_TIMEOUT_MS=10000
VLM_UPLOAD_TIMEOUT_MS=30000
VLM_ANALYZE_TIMEOUT_MS=90000
VLM_ANALYZE_DAILY_LIMIT=100
VLM_MAX_UPLOAD_MB=20
VLM_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
AUTH0_M2M_DOMAIN=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_M2M_AUDIENCE=

## Freecut cut-optimization service (internal-only, no public route).
## Build context is the sibling checkout next to repo_erp under the runtime
## root (~/projects/erp_dev). For a flat checkout, override to ./freecut.
## No secrets: these are tuning knobs only. The backend cut module calls it at
## http://freecut:8088 over the internal "back" network (FREECUT_BASE_URL).
FREECUT_RUST_LOG=info
FREECUT_MAX_BODY_BYTES=5242880
FREECUT_MAX_INSTANCES=5000
FREECUT_DEFAULT_TIME_LIMIT_MS=1200
FREECUT_DEFAULT_RESTARTS=5
FREECUT_MAX_CONCURRENT_OPTIMIZE=1
## Queue wait for a free optimize slot before 429 OVERLOADED. Keep below the
## backend FREECUT_OPTIMIZE_TIMEOUT_MS (15000), otherwise the backend gives up
## while the request still occupies the freecut queue.
FREECUT_OPTIMIZE_QUEUE_WAIT_MS=10000
## Auto fast-engine (freecut heuristic+cut_quality=max) for cut groups with at
## least this many detail instances; 0 disables auto mode (profiles with an
## explicit engine still apply). Rollback knob for the cut engine rollout.
BACKEND_CUT_HEURISTIC_AUTO_THRESHOLD=100
FREECUT_CPUS=1.5
FREECUT_MEM_LIMIT=512m

## CAD SVG/DXF service. Two doors, one container:
##  - internal: backend reaches http://cad-service:8000 over the "back" network
##    and is token-free (source IP in trusted Docker CIDR);
##  - public: traefik routes https://CAD_FQDN to it. TRUST_PROXY_HEADERS=1 makes
##    the service read the real client IP from X-Forwarded-For, so external
##    callers MUST send Authorization: Bearer CAD_SERVICE_API_TOKEN.
## Build context is the sibling checkout next to repo_erp under the runtime root
## (~/projects/erp_dev). For a flat checkout, override to ./repo_svgdxf.
## Generate the token with: openssl rand -hex 32
CAD_BUILD_CONTEXT=./repo_svgdxf
CAD_SERVICE_API_TOKEN=REPLACE_ME_CAD_TOKEN_openssl_rand_hex_32
CAD_SERVICE_TRUSTED_CIDRS=127.0.0.0/8,::1/128,172.16.0.0/12
## Default 1 (matches the compose default): behind traefik the service reads the
## real client IP from X-Forwarded-For, so public callers fail closed and MUST
## send Authorization: Bearer CAD_SERVICE_API_TOKEN. Set to 0 only if the public
## route is instead gated by traefik basic auth and you want the app to trust the
## proxy as a direct, token-free client.
CAD_SERVICE_TRUST_PROXY_HEADERS=1
## Backend's internal base URL for the CAD service (no public route needed).
CAD_SERVICE_BASE_URL=http://cad-service:8000
## HTTP basic auth for the public CAD UI (traefik edge). Format: user:apr1hash.
## Generate with: openssl passwd -apr1 'your-password' then prefix "user:".
## IMPORTANT: double every '$' to '$$' here — compose interpolates the value
## into the traefik label and would otherwise eat the hash segments.
## Empty value makes traefik reject all browser access (fail closed).
CAD_BASICAUTH_USERS=cad:$$apr1$$REPLACE$$ME_apr1_hash
## Blast-radius caps so CAD problems cannot starve sibling containers.
CAD_CPUS=1.0
CAD_MEM_LIMIT=512m
CAD_PIDS_LIMIT=256

## Bitrix24 CRM one-way sync: ERP clients → Contact/Company, orders → Deal,
## ERP payments → native deal payments. Default OFF and fail-closed.
BACKEND_ENABLE_BITRIX24_SYNC=false
BACKEND_BITRIX24_SYNC_RELAY_OWNER=none
BACKEND_BITRIX24_SYNC_DRY_RUN=false
BACKEND_BITRIX24_SYNC_POLL_INTERVAL_MS=60000
BACKEND_BITRIX24_SYNC_BATCH_SIZE=100
BACKEND_BITRIX24_SYNC_MAX_ATTEMPTS=10
BACKEND_BITRIX24_SYNC_WORKER_ID=bitrix24-sync-local
BACKEND_BITRIX24_SYNC_LEASE_MS=300000
## Replace placeholder host outside git. Create an incoming webhook as an
## administrator with CRM and sale/payment rights
## (sale.payment.update is admin-only). Keep complete URL secret.
BITRIX24_WEBHOOK_ALLOWED_HOST=portal.example.invalid
BITRIX24_WEBHOOK_URL=
BITRIX24_REQUEST_TIMEOUT_MS=30000
BITRIX24_CURRENCY_ID=KZT
## Numeric Bitrix payment-system ID. Required when sync is enabled.
BITRIX24_PAY_SYSTEM_ID=
## Optional numeric responsible user. Empty uses the webhook owner/default.
BITRIX24_ASSIGNED_BY_ID=

## CNC Telegram worker (Telethon MTProto, internal-only, profile-gated).
## Full writer worker must run on exactly one stack for a shared Telegram chat.
## Production writer:
##   ERP_STACK_ENV=prod
##   BACKEND_ENABLE_CNC_TELEGRAM=true
##   COMPOSE_PROFILES=cnc-telegram
##   CNC_TELEGRAM_WORKER_ROLE=writer
## Test/default:
##   ERP_STACK_ENV=test
##   CNC_TELEGRAM_WORKER_ROLE=reader
## Roles: disabled=no access, reader=read/parse only, writer=read + Telegram replies.
## CNC_TELEGRAM_ALLOW_NON_PROD_WRITER applies only to writer; keep false on test.
## First-time login creates /data/session/cnc_telegram.session in the named
## volume:
##   docker compose --env-file .env -f docker-compose.yml run --rm cnc-telegram-worker login
## TELEGRAM_CHAT accepts a numeric chat/channel id or username. Keep
## TELEGRAM_ALLOWED_CHAT_ID set to the expected id as a fail-closed guard.
CNC_TELEGRAM_WORKER_BUILD_CONTEXT=./repo_erp/cnc-telegram-worker
CNC_TELEGRAM_WORKER_ROLE=reader
CNC_TELEGRAM_ALLOW_NON_PROD_WRITER=false
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_CHAT=
TELEGRAM_ALLOWED_CHAT_ID=
TELEGRAM_SESSION_PATH=/data/session/cnc_telegram
CNC_TELEGRAM_ERP_API_URL=http://backend:3000/api/v1
CNC_TELEGRAM_ERP_API_TOKEN=

## OCR command must print structured JSON to stdout. Recommended CPU engine:
## RapidOCR/PP-OCRv5 via the internal ocr-service; GLM-OCR remains optional fallback.
CNC_OCR_COMMAND=python -m cnc_telegram_worker.rapid_ocr_client --image {image}
CNC_RAPID_OCR_URL=http://ocr-service:8000/ocr
CNC_RAPID_OCR_TIMEOUT_SECONDS=120
CNC_OCR_ENGINE=rapidocr-ppocrv5-eslav
GLM_OCR_RUNNER_URL=http://glm-ocr-runner:8001/ocr
GLM_OCR_CLIENT_TIMEOUT_SECONDS=660
CNC_PARSER_VERSION=cnc-telegram-worker-v11
CNC_MACHINE_DEFAULT=
CNC_DEFAULT_MATERIAL="МДФ 16мм"
CNC_BUSINESS_TIMEZONE=Asia/Almaty
CNC_HISTORY_DAYS=7
CNC_POLL_INTERVAL_SECONDS=60
CNC_TEMP_TTL_HOURS=24
CNC_ATTACHMENT_TTL_HOURS=720
CNC_MAX_MESSAGES_PER_SCAN=1000
CNC_TEMP_DIR=/data/tmp
CNC_MEDIA_DIR=/data/cnc-telegram-media
CNC_TELEGRAM_MEDIA_DIR=/data/cnc-telegram-media
CNC_STATE_PATH=/data/state.json
CNC_RESEND_UNCHANGED=false
CNC_BACKFILL_ON_START=true
CNC_TELEGRAM_WORKER_CPUS=1.0
CNC_TELEGRAM_WORKER_MEM_LIMIT=1024m
CNC_TELEGRAM_WORKER_PIDS_LIMIT=128
CNC_ENABLE_GLM_OCR=false

## GLM-OCR runner services. `glm-ocr-model-init` downloads the GGUF model and
## mmproj into a Docker volume; the llama server and runner stay internal.
## Model files are large. First start can take minutes.
GLM_OCR_MODEL_INIT_IMAGE=curlimages/curl:8.10.1
GLM_OCR_MODEL_URL=https://huggingface.co/ggml-org/GLM-OCR-GGUF/resolve/main/GLM-OCR-Q8_0.gguf?download=true
GLM_OCR_MMPROJ_URL=https://huggingface.co/ggml-org/GLM-OCR-GGUF/resolve/main/mmproj-GLM-OCR-Q8_0.gguf?download=true
GLM_OCR_MODEL_FILE=GLM-OCR-Q8_0.gguf
GLM_OCR_MMPROJ_FILE=mmproj-GLM-OCR-Q8_0.gguf
GLM_OCR_MODEL_INIT_CPUS=1.0
GLM_OCR_MODEL_INIT_MEM_LIMIT=256m
GLM_OCR_MODEL_INIT_PIDS_LIMIT=128
GLM_OCR_LLAMA_IMAGE=ghcr.io/ggml-org/llama.cpp:server
GLM_OCR_MODEL_ALIAS=glm-ocr
GLM_OCR_CTX_SIZE=12000
GLM_OCR_PARALLEL=1
GLM_OCR_THREADS=2
GLM_OCR_LLAMA_CPUS=2.0
GLM_OCR_LLAMA_MEM_LIMIT=4096m
GLM_OCR_LLAMA_PIDS_LIMIT=256
GLM_OCR_RUNNER_BUILD_CONTEXT=./repo_erp/glm-ocr-runner
LLAMA_SERVER_URL=http://glm-ocr-llama:8080
GLM_OCR_TIMEOUT_SECONDS=600
GLM_OCR_MAX_TOKENS=2048
GLM_OCR_RESPONSE_FORMAT=false
GLM_OCR_MAX_IMAGE_BYTES=10485760
GLM_OCR_MAX_WAITING=2
GLM_OCR_RUNNER_CPUS=0.5
GLM_OCR_RUNNER_MEM_LIMIT=512m
GLM_OCR_RUNNER_PIDS_LIMIT=128

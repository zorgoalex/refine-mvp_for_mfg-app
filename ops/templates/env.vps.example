# Copy to .env on the VPS and replace every REPLACE_ME / example domain.
# Keep this file shell-compatible: no spaces around "=" and quote values with
# spaces or special shell characters.

COMPOSE_PROJECT_NAME=erp_test
EDGE_NETWORK_NAME=erp_test_edge

## Public domains
## FQDN values are hostnames only, without https:// and without path.
HASURA_FQDN=hasura-test.example.com
BACKEND_FQDN=backend-test.example.com

## Browser origin of the frontend that will call backend/Hasura.
## Origin includes scheme and host, no trailing slash.
FRONTEND_ORIGIN=https://app-test.example.com

## Traefik / Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com

## Main application database
PG_DB=erpdb
PG_USER=erp_user
PG_PASSWORD=REPLACE_ME_MAIN_DB_PASSWORD

## Published Postgres bind.
## Use 127.0.0.1 for no external DB access.
## Use the VPS Tailscale IP when backup/restore/admin access over tailnet is needed.
PG_BIND_IP=127.0.0.1

## Hasura connects to the business DB.
## If the DB is local in this compose stack, use postgresdb as host.
## URL-encode PG_USER/PG_PASSWORD if they contain @ : / ? # or spaces.
HASURA_GRAPHQL_DATABASE_URL=postgres://erp_user:REPLACE_ME_MAIN_DB_PASSWORD@postgresdb:5432/erpdb

## Hasura metadata DB, always local to this stack
HASURA_MD_DB=hasura_md
HASURA_MD_USER=hasura_user
HASURA_MD_PASSWORD=REPLACE_ME_HASURA_METADATA_DB_PASSWORD

## Hasura security/runtime
HASURA_ENABLE_CONSOLE=false
HASURA_ADMIN_SECRET=REPLACE_ME_HASURA_ADMIN_SECRET
HASURA_JWT_SECRET=REPLACE_ME_SHARED_JWT_SECRET_AT_LEAST_32_CHARS
HASURA_LOG_LEVEL=info
HASURA_ENABLED_LOG_TYPES=startup,http-log,webhook-log,websocket-log,query-log

## Hasura CORS: comma-separated browser origins.
HASURA_GRAPHQL_CORS_DOMAIN=https://app-test.example.com

## Backend security/runtime
## Default VPS layout is ~/projects/erp_dev/repo_erp with .env/data/restore
## in ~/projects/erp_dev, so the backend build context is nested under repo_erp.
## For a one-repo checkout, override this to ./backend.
BACKEND_BUILD_CONTEXT=./repo_erp/backend
BACKEND_NODE_ENV=production
BACKEND_APP_NAME=erp-backend
BACKEND_REFRESH_TOKEN_PEPPER=REPLACE_ME_REFRESH_TOKEN_PEPPER_AT_LEAST_32_CHARS
BACKEND_CORS_ALLOWED_ORIGINS=https://app-test.example.com
BACKEND_SWAGGER_ENABLED=false

## Backend feature gates
BACKEND_ENABLE_AUTH=true
BACKEND_ENABLE_ORDERS=true
BACKEND_ENABLE_PAYMENTS=true
BACKEND_ENABLE_PRODUCTION_ACTIONS=false
BACKEND_ENABLE_CLIENT_PHONES=false
BACKEND_ORDERS_READ_ONLY=false
BACKEND_ENABLE_USERS=true
BACKEND_ENABLE_ORDER_EXPORT=true
BACKEND_EXPORT_DISABLED=true
BACKEND_ENABLE_VLM=true
BACKEND_VLM_DISABLED=true
BACKEND_ENABLE_PROJECTS=false
BACKEND_PROJECTS_READ_ONLY=true
BACKEND_ENABLE_PROJECT_P8_NOTIFICATIONS=false
BACKEND_ENABLE_DEADLINES=false
BACKEND_ENABLE_DEADLINE_ORDER_SYNC=false
BACKEND_DEADLINES_READ_ONLY=true
BACKEND_ENABLE_DEADLINE_WORKER=false
BACKEND_DEADLINE_ACTIONS_ENABLED=false
BACKEND_DEADLINE_NOTIFICATIONS_ENABLED=false
BACKEND_ENABLE_NOTIFICATION_ENGINE=false
BACKEND_NOTIFICATION_RULES_READ_ONLY=true
BACKEND_OUTBOX_RELAY_OWNER=none
BACKEND_OUTBOX_RELAY_POLL_INTERVAL_MS=60000
BACKEND_OUTBOX_RELAY_BATCH_SIZE=100
BACKEND_OUTBOX_RELAY_WORKER_ID=backend-local
BACKEND_OUTBOX_RELAY_MAX_ATTEMPTS=10

## Google Drive export. Required only when BACKEND_EXPORT_DISABLED=false.
GAS_WEBAPP_URL=
GAS_API_KEY=
GAS_EXPORT_TIMEOUT_MS=55000

## VLM. Required only when BACKEND_VLM_DISABLED=false.
VLM_API_URL=
VLM_HEALTH_TIMEOUT_MS=10000
VLM_UPLOAD_TIMEOUT_MS=30000
VLM_ANALYZE_TIMEOUT_MS=90000
VLM_ANALYZE_DAILY_LIMIT=100
VLM_MAX_UPLOAD_MB=20
VLM_ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp
AUTH0_M2M_DOMAIN=
AUTH0_M2M_CLIENT_ID=
AUTH0_M2M_CLIENT_SECRET=
AUTH0_M2M_AUDIENCE=

## Freecut cut-optimization service (internal-only, no public route).
## Build context is the sibling checkout next to repo_erp under the runtime
## root (~/projects/erp_dev). For a flat checkout, override to ./freecut.
## No secrets: these are tuning knobs only. Backend will reach it later at
## http://freecut:8088 over the internal "back" network.
FREECUT_BUILD_CONTEXT=./repo_freecut
FREECUT_RUST_LOG=info
FREECUT_MAX_BODY_BYTES=5242880
FREECUT_MAX_INSTANCES=5000
FREECUT_DEFAULT_TIME_LIMIT_MS=1200
FREECUT_DEFAULT_RESTARTS=5
FREECUT_MAX_CONCURRENT_OPTIMIZE=1
FREECUT_CPUS=1.5
FREECUT_MEM_LIMIT=512m

## Twenty CRM overlay (Phase 1, isolated). Used only when the
## docker-compose.twenty.yml overlay is combined with the base stack.
## Twenty owns its own DB/Redis here; no shared schema with ERP yet.
## Public hostname for the Twenty UI/API behind our Traefik.
TWENTY_FQDN=crm-test.example.com
## SERVER_URL must be the full external origin (scheme + host, no trailing slash).
TWENTY_SERVER_URL=https://crm-test.example.com
## Required: pin an immutable Twenty release tag or @sha256 digest.
## There is no `latest` fallback — the server owns DB migrations, so a silent
## image bump would auto-migrate Twenty's DB and break rollback.
TWENTY_TAG=REPLACE_ME_TWENTY_RELEASE_TAG
## Twenty's own Postgres (separate from the ERP business DB).
TWENTY_PG_DB=default
TWENTY_PG_USER=postgres
TWENTY_PG_PASSWORD=REPLACE_ME_TWENTY_DB_PASSWORD_NO_SPECIAL_CHARS
## Generate once and never rotate without FALLBACK_ENCRYPTION_KEY:
##   openssl rand -base64 32
## Losing this key means losing every secret stored in Twenty's DB.
TWENTY_ENCRYPTION_KEY=REPLACE_ME_TWENTY_ENCRYPTION_KEY
## Set ONLY during key rotation to the previous ENCRYPTION_KEY; blank otherwise.
TWENTY_FALLBACK_ENCRYPTION_KEY=
## local file storage volume by default; switch to s3 + STORAGE_S3_* for prod.
TWENTY_STORAGE_TYPE=local
## Resource caps so Twenty cannot starve the ERP stack on a shared host.
## Phase-1 defaults: total ~3.25 vCPU limit + ~3.0 GB on a 4 vCPU / 7.6 GB box.
## Worker memory is kept >= server (upstream sizes background jobs higher than
## the web tier). Validate against real boot/job peak before raising; size the
## host up for combined production.
TWENTY_CPUS=1.5
TWENTY_MEM_LIMIT=1280m
TWENTY_WORKER_CPUS=1.0
TWENTY_WORKER_MEM_LIMIT=1280m
TWENTY_DB_CPUS=0.5
TWENTY_DB_MEM_LIMIT=384m
TWENTY_REDIS_CPUS=0.25
TWENTY_REDIS_MEM_LIMIT=96m

[Unit]
Description=Order SSE exact-SHA continuous canary
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/state/erp-order-sse
EnvironmentFile=%h/.local/state/erp-order-sse/continuous.env
ExecStart=%h/.local/libexec/erp-order-sse/order-sse-continuous-once.sh
KillMode=mixed
TimeoutStartSec=120s
TimeoutStopSec=35s

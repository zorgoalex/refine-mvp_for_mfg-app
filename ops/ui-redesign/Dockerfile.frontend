FROM node:20-bookworm-slim AS build

WORKDIR /app

COPY package*.json ./
RUN npm ci

COPY . .

ENV VITE_HASURA_GRAPHQL_URL=/v1/graphql
ENV VITE_API_URL=
ENV VITE_RUNTIME_CONFIG_URL=/runtime-config.json

RUN npm run build

FROM nginx:1.27-alpine AS runtime

COPY ops/ui-redesign/nginx.conf /etc/nginx/conf.d/default.conf
COPY ops/ui-redesign/runtime-config.json /usr/share/nginx/html/runtime-config.json
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=10s --timeout=3s --start-period=5s --retries=10 \
  CMD wget -qO- http://127.0.0.1/healthz >/dev/null || exit 1


  "financials": {
    "comment": "Stage «финансы» (plan 2026-10-17-finances-plan.md): money columns of the sources are read only through the relationship `financials` to the projections; a projection has no root fields, so it is reached only from a row the role reads, and its select needs orders.view_financials. F1 adds projections + relationships; F2 removes the money columns from every role's select of the sources. otherColumns = every other column of the source (checked against the database before F2).",
    "permission": "orders.view_financials",
    "relationship": "financials",
    "projections": {
      "order_financials_view": { "base": "orders_view", "mapping": { "order_id": "order_id" }, "columns": ["order_id", "payment_status_id", "payment_status_name", "total_amount", "final_amount", "discount", "surcharge", "paid_amount", "payment_date"] },
      "order_detail_financials_view": { "base": "order_details", "mapping": { "detail_id": "detail_id" }, "columns": ["detail_id", "order_id", "milling_cost_per_sqm", "detail_cost"] },
      "doweling_order_financials_view": { "base": "doweling_orders", "mapping": { "doweling_order_id": "doweling_order_id" }, "columns": ["doweling_order_id", "payment_status_id", "payment_status_name", "total_amount", "final_amount", "discount", "surcharge", "paid_amount", "payment_date"] }
    },
    "sources": {
      "orders_view": {
        "projection": "order_financials_view", "mapping": { "order_id": "order_id" },
        "financialColumns": ["payment_status_name", "total_amount", "final_amount", "discount", "surcharge", "paid_amount", "payment_date"],
        "otherColumns": ["order_id", "order_name", "order_name_numeric", "client_id", "client_name", "order_date", "priority", "doweling_order_id", "doweling_order_name", "design_engineer", "completion_date", "planned_completion_date", "order_status_name", "production_status_name", "issue_date", "parts_count", "total_area", "milling_type_name", "edge_type_name", "film_name", "material_name", "notes", "link_cutting_file", "link_cutting_image_file", "order_ref_key_1c", "client_ref_key_1c", "manager_id", "created_by", "edited_by", "created_at", "updated_at", "version", "sheet_material_type_id", "project_id", "project_code", "order_full_number", "order_kind", "source_system", "production_detail_count", "production_unassigned_count", "production_distinct_status_count"]
      },
      "order_details": {
        "projection": "order_detail_financials_view", "mapping": { "detail_id": "detail_id" },
        "financialColumns": ["milling_cost_per_sqm", "detail_cost"],
        "otherColumns": ["detail_id", "order_id", "detail_number", "height", "width", "quantity", "area", "material_id", "milling_type_id", "edge_type_id", "film_id", "note", "detail_name", "priority", "production_status_id", "joint_order_id", "link_cutting_file", "link_cutting_image_file", "link_cad_file", "link_pdf_file", "delete_flag", "version", "ref_key_1c", "created_by", "edited_by", "created_at", "updated_at", "sheet_material_type_id", "basis_project", "basis_data", "basis_designation", "basis_product", "doweling", "hdf_parameter_override_mm"]
      },
      "order_details_view": {
        "projection": "order_detail_financials_view", "mapping": { "detail_id": "detail_id" },
        "financialColumns": ["milling_cost_per_sqm", "detail_cost"],
        "otherColumns": ["detail_id", "order_id", "detail_number", "detail_name", "height", "width", "quantity", "area", "material_id", "sheet_material_type_id", "material_name", "milling_type_id", "edge_type_id", "film_id", "priority", "production_status_id", "joint_order_id", "note", "link_cutting_file", "link_cutting_image_file", "link_cad_file", "link_pdf_file", "ref_key_1c", "basis_project", "basis_data", "basis_designation", "basis_product", "doweling", "milling_type_name", "film_name"]
      },
      "doweling_orders": {
        "projection": "doweling_order_financials_view", "mapping": { "doweling_order_id": "doweling_order_id" },
        "financialColumns": ["payment_status_id", "total_amount", "final_amount", "discount", "surcharge", "paid_amount", "payment_date"],
        "otherColumns": ["doweling_order_id", "doweling_order_name", "doweling_order_date", "order_id", "production_status_id", "issue_date", "parts_count", "link_cad_file", "link_pdf_file", "delete_flag", "version", "ref_key_1c", "created_by", "edited_by", "created_at", "updated_at", "design_engineer_id", "operator_id", "client_id", "client_source"]
      },
      "doweling_orders_view": {
        "projection": "doweling_order_financials_view", "mapping": { "doweling_order_id": "doweling_order_id" },
        "financialColumns": ["payment_status_name", "total_amount", "final_amount", "discount", "surcharge", "paid_amount", "payment_date"],
        "otherColumns": ["doweling_order_id", "doweling_order_name", "order_id", "order_name", "client_id", "client_name", "doweling_order_date", "production_status_name", "issue_date", "parts_count", "milling_type_name", "edge_type_name", "material_name", "design_engineer_id", "design_engineer", "operator_id", "operator", "link_cad_file", "link_pdf_file", "version", "order_ref_key_1c", "client_ref_key_1c", "created_by", "edited_by", "created_at", "updated_at", "delete_flag", "client_source", "bazis_xml_count"]

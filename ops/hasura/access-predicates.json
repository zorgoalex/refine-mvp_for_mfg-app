    { "table": "order_resource_requirements", "type": "object", "name": "order", "remoteTable": "orders", "columnMapping": { "order_id": "order_id" } }
  ],
  "exceptions": {
    "app_settings.select": "UI settings and the navigation visibility are read by every role (no secrets; plan §4 0Б.5)"
